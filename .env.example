# --- Seguridad (JWT) ---
# IMPORTANTE: Cambia la SECRET_KEY por una clave segura en producción.
# Puedes generar una usando: openssl rand -hex 32
SECRET_KEY=generar_una_clave_aleatoria_muy_larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Credenciales Admin (Seeding) ---
ADMIN_EMAIL=admin_obligatorio@ejemplo.com
ADMIN_PASSWORD=cambiame_por_algo_seguro

# --- Base de Datos (SQLite) ---
# En Docker, se recomienda usar una ruta absoluta dentro del volumen
DATABASE_URL=sqlite:///./data/sql_app.db

# --- Configuración de la App ---
LOG_LEVEL=INFO
APP_TITLE="Expediente Management System API"
APP_DESCRIPTION="API for Expediente Management System"
APP_VERSION=1.0.0

# --- Seguridad (CORS) ---
# Para múltiples orígenes usar: http://localhost:3000,http://myapp.com
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
