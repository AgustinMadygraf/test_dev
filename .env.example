# --- Seguridad (JWT) ---
# IMPORTANTE: Cambia la SECRET_KEY por una clave segura en producción.
# Puedes generar una usando: openssl rand -hex 32
SECRET_KEY=tu_clave_secreta_aqui_no_la_compartas
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Base de Datos ---
# Para SQLite (desarrollo), deja DB_HOST como 'localhost' o vacío.
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expedientes.sqlite

# --- Configuración de la App ---
LOG_LEVEL=INFO
APP_TITLE="Expediente Management System API"
APP_DESCRIPTION="API for Expediente Management System"
APP_VERSION=1.0.0

# --- Seguridad (CORS) ---
# Para múltiples orígenes usar: http://localhost:3000,http://myapp.com
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
