# Configuración de Base de Datos
# Si DB_HOST se deja vacío o en localhost, se usará SQLite por defecto
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=expedientes.sqlite

# Configuración de la App
LOG_LEVEL=INFO

# Seguridad (CORS)
# Para múltiples orígenes usar: http://localhost:3000,http://myapp.com
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*